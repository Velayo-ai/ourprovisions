# Build-time only, no secrets. CRA expands $VARS from the build environment (dotenv-expand) and never
# overrides a variable already set (Vercel's own env vars win). Vercel sets VERCEL_GIT_COMMIT_SHA on
# every build; a local build leaves it empty and rum.js falls back.
REACT_APP_GIT_SHA=$VERCEL_GIT_COMMIT_SHA
