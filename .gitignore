# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Claude Code — track shared project settings, ignore local overrides
.claude/settings.local.json

# QA fixture — real IDs live outside the repo (secrets hygiene)
qa/test_fixture.dev.json

*.dump

# Supabase CLI scratch (`supabase link`, `functions deploy`, `db query --linked` write version
# caches, the pooler URL and the project ref here). `.temp/linked-project.json` IS tracked on
# purpose — it names the dev project — so the folder's contents are ignored, not the folder.
supabase/.temp/*
!supabase/.temp/linked-project.json

# local verification helper; bakes in the dev anon key, never committed
scripts/verify6.ps1

# recipe-import test fixtures — real screenshots (personal captions/handles), never committed
scripts/recipe-fixtures/

# recipe-import standalone probe; takes a live dev JWT at the prompt, never committed
scripts/recipe_import_probe.ps1
